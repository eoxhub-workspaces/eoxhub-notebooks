lumn":1}},"key":"JLXCG4wrqS"}],"key":"wIQ4Cg8VpV"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Autologging is convenient when we want quick experiment tracking without adding many explicit ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"XphVVusNxd"},{"type":"inlineCode","value":"mlflow.log_*","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xqBZgv4czA"},{"type":"text","value":" calls to the training code.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lDj2OZSaGk"}],"key":"PxGJDLHmPy"}],"key":"N2yXNTQDvU"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Using autolog() function from appropriate flavor corresponding to code will automatically log all parameters and metrics available. Many flavors support adding log_models=True argument to automatically log model.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"K8SPruHvTY"}],"key":"uc0bQ7x9OH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"List of supported flavours and the documentation can be found here: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sCYEYynucz"},{"type":"link","url":"https://mlflow.org/docs/latest/tracking.html#automatic-logging","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"https://​mlflow​.org​/docs​/latest​/tracking​.html​#automatic​-logging","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ggf1WPneue"}],"urlSource":"https://mlflow.org/docs/latest/tracking.html#automatic-logging","key":"e61Ogqt6E2"}],"key":"UqYLNlhXxY"}],"key":"U3hovSheK1"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"!pip3 install tensorflow","visibility":"show","key":"KGtbrLpjPz"},{"type":"outputs","id":"g1V1LJUPsFmMQwfOWcNy-","children":[],"visibility":"show","key":"wYpUngTi3r"}],"visibility":"show","key":"BnFdOYgot6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"TensorFlow example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ICBZUW9ULw"}],"identifier":"tensorflow-example","label":"TensorFlow example","html_id":"tensorflow-example","implicit":true,"key":"ZwdhMyo3ly"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This example trains a small neural network using TensorFlow/Keras and logs the training process with MLflow autologging.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LEH3kHS1cs"}],"key":"fAms492p6g"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The model uses the Reuters dataset, which is a small text classification dataset included with Keras. The goal of this example is not to build the best possible model, but to demonstrate how MLflow can capture training information from a TensorFlow workflow.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"UKvJIu29bu"}],"key":"heqWgT7NoB"}],"key":"TzTMWe4mS2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport mlflow\nfrom tensorflow import keras\nfrom tensorflow.keras.datasets import reuters\nfrom tensorflow.keras.models import Sequential\nfrom tensorflow.keras.layers import Input, Dense, Dropout, Activation\nfrom tensorflow.keras.preprocessing.text import Tokenizer\n\n# Start MLflow TensorFlow autologging\nmlflow.tensorflow.autolog()\n\nmax_words = 1000\nbatch_size = 32\nepochs = 5\n\nprint(\"Loading data...\")\n(x_train, y_train), (x_test, y_test) = reuters.load_data(\n    num_words=max_words,\n    test_split=0.2,\n)\n\nprint(len(x_train), \"train sequences\")\nprint(len(x_test), \"test sequences\")\n\n# Cast to plain Python int for newer Keras compatibility\nnum_classes = int(np.max(y_train) + 1)\nprint(num_classes, \"classes\")\n\nprint(\"Vectorizing sequence data...\")\ntokenizer = Tokenizer(num_words=max_words)\nx_train = tokenizer.sequences_to_matrix(x_train, mode=\"binary\")\nx_test = tokenizer.sequences_to_matrix(x_test, mode=\"binary\")\n\nprint(\"x_train shape:\", x_train.shape)\nprint(\"x_test shape:\", x_test.shape)\n\nprint(\"Convert class vector to binary class matrix\")\ny_train = keras.utils.to_categorical(y_train, num_classes)\ny_test = keras.utils.to_categorical(y_test, num_classes)\n\nprint(\"y_train shape:\", y_train.shape)\nprint(\"y_test shape:\", y_test.shape)\n\nprint(\"Building model...\")\nmodel = Sequential()\nmodel.add(Input(shape=(max_words,)))\nmodel.add(Dense(512))\nmodel.add(Activation(\"relu\"))\nmodel.add(Dropout(0.5))\nmodel.add(Dense(num_classes))\nmodel.add(Activation(\"softmax\"))\n\nmodel.compile(\n    loss=\"categorical_crossentropy\",\n    optimizer=\"adam\",\n    metrics=[\"accuracy\"],\n)\n\nhistory = model.fit(\n    x_train,\n    y_train,\n    batch_size=batch_size,\n    epochs=epochs,\n    verbose=1,\n    validation_split=0.1,\n)\n\nscore = model.evaluate(\n    x_test,\n    y_test,\n    batch_size=batch_size,\n    verbose=1,\n)\n\nprint(\"Test score:\", score[0])\nprint(\"Test accuracy:\", score[1])","key":"BEontEdMC2"},{"type":"outputs","id":"02TsDoIlFtLIEmls_lmx7","children":[],"key":"hUSn4LDUzE"}],"key":"DQ2aZySMz9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Manual logging with scikit-learn","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VqqLnfipk3"}],"identifier":"manual-logging-with-scikit-learn","label":"Manual logging with scikit-learn","html_id":"manual-logging-with-scikit-learn","implicit":true,"key":"zKENIknpXP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"In this section, we train a simple scikit-learn model and manually decide what to log to MLflow.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"W6p0KLymoI"}],"key":"ceBfT4zJ0g"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Manual logging gives us more control than autologging. We explicitly log the parameters we care about, such as ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jfLnNne5Zm"},{"type":"inlineCode","value":"alpha","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"RCNUWV5mWY"},{"type":"text","value":" and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tqoCzZSPzi"},{"type":"inlineCode","value":"l1_ratio","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Xp5heQASyJ"},{"type":"text","value":", and the evaluation metrics we want to compare between runs, such as RMSE, MAE, and R².","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"q4zdE3GqBI"}],"key":"xieGcjsYbs"}],"key":"pQIVpANkJZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Almost any code can be wrapped into with ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pCXbUZC44Z"},{"type":"inlineCode","value":"mlflow.start_run() as run:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"plJcpXcc5E"},{"type":"text","value":" and manual logging of selected parameters can be done using:\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"c041fNZs7a"},{"type":"inlineCode","value":"mlflow.log_params()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HDCu5PIs83"},{"type":"text","value":" or\n","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YegBztmeut"},{"type":"inlineCode","value":"mlflow.log_metric()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OAb83Gw1hK"}],"key":"Tfv77BtM5t"}],"key":"FAeUh6dtW9"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport warnings\nimport sys\n\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import ElasticNet\nfrom urllib.parse import urlparse\nimport mlflow\nimport mlflow.sklearn\n\n        ","visibility":"show","key":"ECka47Rjil"},{"type":"outputs","id":"q0DbeZtKbf_Ps7L4NhJux","children":[],"visibility":"show","key":"CKwz2O9SOF"}],"visibility":"show","key":"JRMrYdfgEu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def eval_metrics(actual, pred):\n    rmse = np.sqrt(mean_squared_error(actual, pred))\n    mae = mean_absolute_error(actual, pred)\n    r2 = r2_score(actual, pred)\n    return rmse, mae, r2","key":"HeYnlFZy8a"},{"type":"outputs","id":"za1A8_9kFWp0qd6ueJ4ax","children":[],"key":"khk9ZVj70N"}],"key":"bIVrciDSdD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"csv_url = (\n    \"https://raw.githubusercontent.com/mlflow/mlflow/master/tests/datasets/winequality-red.csv\"\n)\ntry:\n    data = pd.read_csv(csv_url, sep=\";\")\nexcept Exception as e:\n    pass\n\n# Split the data into training and test sets. (0.75, 0.25) split.\ntrain, test = train_test_split(data)\n\n# The predicted column is \"quality\" which is a scalar from [3, 9]\ntrain_x = train.drop([\"quality\"], axis=1)\ntest_x = test.drop([\"quality\"], axis=1)\ntrain_y = train[[\"quality\"]]\ntest_y = test[[\"quality\"]]\n\n\nalpha = 0.5\nl1_ratio = 0.5\n\nwith mlflow.start_run():\n    lr = ElasticNet(alpha=alpha, l1_ratio=l1_ratio, random_state=42)\n    lr.fit(train_x, train_y)\n\n    predicted_qualities = lr.predict(test_x)\n\n    rmse, mae, r2 = eval_metrics(test_y, predicted_qualities)\n\n    print(f\"Elasticnet model (alpha={alpha:f}, l1_ratio={l1_ratio:f}):\")\n    print(f\"  RMSE: {rmse}\")\n    print(f\"  MAE: {mae}\")\n    print(f\"  R2: {r2}\")\n\n    mlflow.log_param(\"alpha\", alpha)\n    mlflow.log_param(\"l1_ratio\", l1_ratio)\n\n    mlflow.set_tag(\"note\", \"tyna was here\")\n\n    mlflow.log_metric(\"rmse\", float(rmse))\n    mlflow.log_metric(\"r2\", float(r2))\n    mlflow.log_metric(\"mae\", float(mae))\n\n    mlflow.sklearn.log_model(\n        sk_model=lr,\n        name=\"model\",\n    )\n","key":"axL9b0AICz"},{"type":"outputs","id":"NHY6sUex9_iuMN3ewmlkv","children":[],"key":"x5vJL5nkVa"}],"key":"RzeBLJKYiq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Inspect the results in MLflow","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"J4gGNRZtv5"}],"identifier":"inspect-the-results-in-mlflow","label":"Inspect the results in MLflow","html_id":"inspect-the-results-in-mlflow","implicit":true,"key":"GgjLVYDN56"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"After running the notebo