091560258], [5.079752631651647, 51.23519531038643], [5.077238400183506, 51.23490534677628], [5.072856439300575, 51.23593546777778], [5.07163184674986, 51.23481147556147]]]}}, \n        {\"type\": \"Feature\", \"properties\": {}, \"geometry\": {\"type\": \"Polygon\", \"coordinates\": [[[5.083897244679042, 51.23510639883143], [5.081302408741335, 51.232922477780846], [5.082963802194108, 51.233146058575876], [5.084497702305552, 51.232672717580655], [5.085732850338428, 51.2340852086282], [5.083897244679042, 51.23510639883143]]]}}\n    ]}\n\"\"\"\n)","key":"It7iYSaL3i"},{"type":"outputs","id":"a8azOEJqmWO9KjTZjwcWf","children":[],"key":"n1X06Yv1ed"}],"key":"LyAk8sFpuJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the “B04” (red) and “B08” (NIR) brands from the  ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Sop51TQSuB"},{"type":"inlineCode","value":"SENTINEL2_L2A","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yIDnohyzzz"},{"type":"text","value":" collection for the desired time window:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"knMCmFqkBA"}],"key":"rKU40WfO5W"}],"key":"LQZ7nfbaX3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"s2cube = connection.load_collection(\n    \"SENTINEL2_L2A\",\n    temporal_extent=[\"2020-06-01\", \"2020-10-01\"],\n    bands=[\"B04\", \"B08\"],\n)","key":"EIgqHbx2wU"},{"type":"outputs","id":"g4wLa3ylx8ZkNxJWXUbHw","children":[],"key":"iW3WgD7VAU"}],"key":"j69eYGCATL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Note here that it is not necessary to specify a spatial extent in ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uHWnVtTqNd"},{"type":"inlineCode","value":"load_collection","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Kxf8v2TKrY"},{"type":"text","value":",\nbecause we will provide the field geometries in a later step.\nThe openEO back-end will automatically limit the effective data loading to the necessary bounding box.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GRF5krjpQ6"}],"key":"kfvLY00yEb"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Calculate the NDVI from the red and NIR bands:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"aG3AZWIfGI"}],"key":"lelaVEywE6"}],"key":"xloejKvUrs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"red = s2cube.band(\"B04\")\nnir = s2cube.band(\"B08\")\nndvi = (nir - red) / (nir + red)","key":"rACGJstc1a"},{"type":"outputs","id":"MyZAWWRjoEejKsAMGXN9h","children":[],"key":"XwtQMTxxBF"}],"key":"Yb1V1t1eGJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"With the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sifDUCrjNb"},{"type":"inlineCode","value":"DataCube.aggregate_spatial()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m9Z1pHZXKo"},{"type":"text","value":" method , we can calculate the mean NDVI for each of the fields.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dA2p10Lvv6"}],"key":"t9WpJhDrAv"}],"key":"mGJPnSG24F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"timeseries = ndvi.aggregate_spatial(geometries=fields, reducer=\"mean\")","key":"xiFwFnrcfh"},{"type":"outputs","id":"WwvO6AdDQ5P8xZQIwgB7b","children":[],"key":"wPonx40b2K"}],"key":"ekWUbjxS3H"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We now execute this as a batch job and download the timeseries in CSV format.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kTJb6FeZk8"}],"key":"BNsZYRf79a"}],"key":"s6wVRog8U1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"timeseries","key":"jWDFG3plUk"},{"type":"outputs","id":"zGIhy5UfFdfnbSudxAMVk","children":[],"key":"ZHAE7Cs7zS"}],"key":"wc2uvt1MLI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"job = timeseries.execute_batch(out_format=\"CSV\", title=\"NDVI timeseries\")","key":"pL43AlgFJm"},{"type":"outputs","id":"B40Sqyjxpgz0cpMZVHkfp","children":[],"key":"ZiyVOiIZEt"}],"key":"FU2xqBqSkR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Download the timeseries CSV:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jigDIzk2Cd"}],"key":"O2RvfbRvLN"}],"key":"cqLN0AdVNB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"job.get_results().download_file(\"ndvi-results/timeseries-basic.csv\")\npd.read_csv(\"ndvi-results/timeseries-basic.csv\", index_col=0).head()","key":"JpzHzNPh4C"},{"type":"outputs","id":"inMEYFtzXc0Yyn-t6r15n","children":[],"key":"ukCszZYazP"}],"key":"DaVv59GmIJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The table above shows the NDVI saved under the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n8bKDP8J0D"},{"type":"inlineCode","value":"band_unnamed","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M1zrabE8bY"},{"type":"text","value":" column corresponding to their respective dates.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"f3mLPBCxqY"}],"key":"C3seVGp7NG"}],"key":"o4DqfJw17N"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let us create a quick plot helper to visualize the NDVI data:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j5X2k6pSbP"}],"key":"ha3cEzND2J"}],"key":"JzV2IQ7Jnq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_timeseries(filename, figsize=(6, 3)):\n    df = pd.read_csv(filename, index_col=0)\n    df.index = pd.to_datetime(df.index)\n    df = df.sort_index()\n    fig, ax = plt.subplots(figsize=figsize, dpi=90)\n    df.groupby(\"feature_index\")[\"band_unnamed\"].plot(marker=\"o\", ax=ax)\n    ax.set_title(filename.split(\"/\")[-1])\n    ax.set_ylabel(\"NDVI\")\n    ax.set_ylim(0, 1)\n    ax.legend(title=\"parcel id\", loc=\"lower left\", ncol=2)","key":"FfiaV5wBXP"},{"type":"outputs","id":"ArCuzRuKf6t88lB68MmID","children":[],"key":"UQkXvQlkt2"}],"key":"ZonJgdHK13"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_timeseries(\"ndvi-results/timeseries-basic.csv\")","key":"SYiZsxjZfZ"},{"type":"outputs","id":"t0M7wLfZ-SHvt_Y198tXf","children":[],"key":"CPBtV1v1U4"}],"key":"Y0T3OTiqMo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cloud Masking in NDVI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"R5RxFM0YGP"}],"identifier":"cloud-masking-in-ndvi","label":"Cloud Masking in NDVI","html_id":"cloud-masking-in-ndvi","implicit":true,"key":"CywqBrClNp"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The result above is a good start, but there is room for improvement to get smoother NDVI profiles.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ISzItk1m9l"}],"key":"YcePIE2BX1"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"There are quite some outliers because we didn’t filter out cloudy observations or pixels.\nWe can use the “SCL” (scene classification) band from the “SENTINEL2_L2A” collection to focus on non-cloud pixels.\nLet’s load an “SENTINEL2_L2A” data cube again, with the additional “SCL” band, and calculate the NDVI like before:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"znEJbqtbmp"}],"key":"h5K1WpFNWC"}],"key":"ID4bnRT88U"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"s2cube = connection.load_collection(\n    \"SENTINEL2_L2A\",\n    temporal_extent=[\"2020-06-01\", \"2020-10-01\"],\n    bands=[\"B04\", \"B08\", \"SCL\"],\n)\nred = s2cube.band(\"B04\")\nnir = s2cube.band(\"B08\")\nndvi = (nir - red) / (nir + red)","key":"LGZGVWhTwI"},{"type":"outputs","id":"bAuN-NkHtWmKCyxtb5NZZ","children":[],"key":"Az58g3zxhV"}],"key":"I9rgAxAqC7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Now, from the “SCL” band we will build a mask to remove everything that is not class 4 (“vegetation”) or 5 (“not vegetated”).\nThis mask data cube is 1 for pixels which we want to remove (clouds, cloud shadow, ...) and 0 for pixels we want to keep.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KZGC27sxxI"}],"key":"xdAVRMFGyA"}],"key":"nJenVQhG9W"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"scl = s2cube.band(\"SCL\")\nmask = ~((scl == 4) | (scl == 5))","key":"JWiJpfcog8"},{"type":"outputs","id":"bonDK2vz_9dknOww-DmMN","children":[],"key":"Y6xgMwqKtY"}],"key":"Jt5P3wcEYz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"This mask is however a bit noisy (because of imperfect classification) and to be a bit conservative we also want to expand it a bit to exclude extra pixels at cloud edges.\nWe can do this morphological operation by using a convolution with a gaussian kernel and applying a threshold to get a binary mask again.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eiOfi2u9kb"}],"key":"E8EC1xS8cI"}],"key":"MsettILEoP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 2D gaussian kernel\ng = scipy.signal.windows.gaussian(11, std=1.6)\nkernel = np.outer(g, g)\nkernel = kernel / kernel.sum()\n\n# Morphological dilation of mask: convolution + threshold\nmask = mask.apply_kernel(kernel)\nmask = mask > 0.1","key":"bVmshUPKJd"},{"type":"outputs","id":"gFKBEFeMhfDwl4hl1xPBe","children":[],"key":"I0LRyCxWM2"}],"key":"HBwapHzlYV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now, we mask the NDVI data cube and do aggregation again:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UfeZfFI8j6"}],"key":"YeeBQKl2ZU"}],"key":"CBZMu0bEW9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ndvi_masked = ndvi.mask(mask)\ntimeseries_masked = ndvi_masked.aggregate_spatial(geometries=fields, reducer=\"mean\")","key":"sfJWi5MCze"},{"type":"outputs","id":"Rr3XHvRraZ5_AR7WODr1I","children":[],"key":"sl8DUBbFCQ"}],"key":"MdKMoyD7VJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"job = timeseries_masked.execute_batch(out_format=\"CSV\", title=\"Maked NDVI timeseries\")","key":"CGmKggA1Zz"},{"type":"outputs","id":"1wTP3F0L1YUjhq2h_LkGx","children":[],"key":"N9me6jtI8M"}],"key":"d1ZaIIlSGj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"job.get_results().download_file(\"ndvi-results/timeseries-masked.csv\")","key":"SJ334lEMh8"},{"type":"outputs","id":"EU4FHiq3FyQ-UwLomVz58","children":[],"key":"kuWcww9aE4"}],"key":"YPKvHd2qPN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_timeseries(\"ndvi-results/timeseries-masked.csv\")","key":"KzcIV9j2Qv"},{"type":"outputs","id":"3e6uJ68cDhMQo0cd1j2eM","children":[],"key":"BTlempG0Os"}],"key":"vPQMCIFGrK"}],"key":"FwkTT0BefX"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"MLflow connection examples","url":"/notebooks/mlflow/mlflow-examples","group":"Mlflow"},"next":{"title":"Scale your processes with Dask - hands on example","url":"/notebooks/pangeo-dask-notebooks/example-wildfires","group":"Pangeo Dask Notebooks"}}},"domain":"http://localhost:3000"}