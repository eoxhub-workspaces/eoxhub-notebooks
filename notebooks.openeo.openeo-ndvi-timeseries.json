{"version":3,"kind":"Notebook","sha256":"ba03d26851a3d73fbe2043466e417089f60a3d3912508c85fa656fc762eef738","slug":"notebooks.openeo.openeo-ndvi-timeseries","location":"/notebooks/openEO/openEO_NDVI_Timeseries.ipynb","dependencies":[],"frontmatter":{"title":"How to create an NDVI Time series using openEO","content_includes_title":false,"kernelspec":{"name":"conda-env-oscar-strasser-oscar-strasser-eoxhub_notebooks-py","display_name":"oscar-strasser-oscar-strasser-eoxhub_notebooks","language":"python"},"github":"https://github.com/eoxhub-workspaces/eoxhub-notebooks","subject":"Notebook examples","numbering":{"title":{"offset":2}},"source_url":"https://github.com/eoxhub-workspaces/eoxhub-notebooks/blob/main/notebooks/openEO/openEO_NDVI_Timeseries.ipynb","edit_url":"https://github.com/eoxhub-workspaces/eoxhub-notebooks/edit/main/notebooks/openEO/openEO_NDVI_Timeseries.ipynb","exports":[{"format":"ipynb","filename":"openEO_NDVI_Timeseries.ipynb","url":"/eoxhub-notebooks/build/openEO_NDVI_Timeseri-993f3fa41d61159441221255b453774d.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","data":{"collapsed":false,"jupyter":{"outputs_hidden":false}},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook presents an application case, that demonstrates how to display the NDVI (Normalized Difference Vegetation Index) timeseries for specific fields. The case study showcases the process of selecting the fields and generating average NDVI timeseries data for analysis and visualization.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wdpD0OPpY5"}],"key":"HDaOEFuXKU"}],"key":"Skmdvfb9Ed"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Setup","position":{"start":{"line":1,"col